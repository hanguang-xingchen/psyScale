  "titleEn": "Symptom Checklist-90",
  "description": "廣泛用於心理健康評估的自評量表，涵蓋 9 個症狀構面及睡眠飲食等附加項目",
  "instruction": "請根據您最近一週（包括今天）的實際感受，選擇最符合您情況的選項。",
  "author": "Derogatis et al.",
  "year": 1973,
  "language": "zh-TW",

  "source": {
    "type": "csv",
    "file": "items.csv",
    "optionPrefix": "opt_",
    "valuePrefix": "val_",
    "dimensions": true
  },

  "scoring": {
    "type": "dimensionSum",
    "missingValuePolicy": "warn"
  },

  "interpretation": [
